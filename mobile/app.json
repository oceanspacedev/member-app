{
  "expo": {
    "name": "Space Club",
    "slug": "ocean-space",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "oceanspace",
    "userInterfaceStyle": "light",
    "primaryColor": "#1E40AF",
    "ios": {
      "bundleIdentifier": "id.co.oceanspace.member",
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/ios-dark.png",
        "tinted": "./assets/images/ios-tinted.png"
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "id.co.oceanspace.member",
      "adaptiveIcon": {
        "backgroundColor": "#1E40AF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1E40AF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 110
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Izinkan $(PRODUCT_NAME) memakai kamera untuk memotret struk belanja dan foto profil, serta memindai QR di kasir.",
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Izinkan $(PRODUCT_NAME) memakai lokasi untuk menampilkan outlet terdekat.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": false
        }
      ],
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Izinkan $(PRODUCT_NAME) mengakses galeri untuk memilih foto struk belanja dan foto profil.",
          "cameraPermission": "Izinkan $(PRODUCT_NAME) memakai kamera untuk memotret struk belanja dan foto profil, serta memindai QR di kasir.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
